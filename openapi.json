{
  "openapi": "3.0.3",
  "info": {
    "title": "代理兑换接口",
    "version": "1.0.0",
    "description": "代理的服务器用 API 密钥调用：查卡密 → 核对账号（拿 ticket）→ 确认兑换（ticket + idempotency_key → 订单号）→ 按 poll_after 查订单直到出结果。\n\n完整说明（重试规则、状态处理、上线前自检）见随附的《代理对接文档》。所有响应都是 `{ok, data | error, trace_id}`；失败时按 `error.code` 写判断，`error.message` 是可以直接给买家看的中文句子。"
  },
  "servers": [
    {
      "url": "https://recharge.chongplus.store/api/open/v1",
      "description": "正式接口"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "联调",
      "description": "验证密钥、看我们看到的来源 IP"
    },
    {
      "name": "兑换",
      "description": "查卡密、核对账号、确认兑换"
    },
    {
      "name": "订单",
      "description": "查订单、按卡密找回订单"
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "tags": [
          "联调"
        ],
        "operationId": "ping",
        "summary": "验证密钥",
        "description": "检查密钥是否有效，返回这把密钥的名字、我们看到的你的来源 IP（登记 IP 名单时以它为准）和限额。",
        "responses": {
          "200": {
            "description": "密钥有效",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "成功",
                  "required": [
                    "ok",
                    "data",
                    "trace_id"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/PingData"
                    },
                    "trace_id": {
                      "$ref": "#/components/schemas/TraceID"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "data": {
                    "name": "代理甲",
                    "ip": "203.0.113.10",
                    "server_time": "2026-10-05T09:00:00Z",
                    "limits": {
                      "rate_per_min": 60,
                      "max_inflight": 5
                    }
                  },
                  "trace_id": "9F2A41C07B"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_key`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_key": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "invalid_key",
                        "message": "密钥无效或已停用",
                        "retryable": false
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "`ip_not_allowed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ip_not_allowed": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "ip_not_allowed",
                        "message": "当前请求来源的 IP 不在这把密钥允许的名单里",
                        "retryable": false,
                        "details": {
                          "ip": "203.0.113.99"
                        }
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "`too_many_failures`、`rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "`service_disabled`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cdk/query": {
      "post": {
        "tags": [
          "兑换"
        ],
        "operationId": "queryCDK",
        "summary": "查卡密",
        "description": "查一张卡密是什么套餐、现在能不能用。只是查询，不消耗卡密；同一张卡密 60 秒内的重复查询可能直接返回缓存结果。你这把密钥自己已经提交过这张卡密的订单时直接告诉你：还在处理是 `cdk_not_usable`，已经兑换成功是 `cdk_used`，都带 `error.details.order_no`。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CDKRequest"
              },
              "example": {
                "cdk": "XXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXX"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "卡密可以用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "成功",
                  "required": [
                    "ok",
                    "data",
                    "trace_id"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/QueryData"
                    },
                    "trace_id": {
                      "$ref": "#/components/schemas/TraceID"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "data": {
                    "plan": "pro-5x",
                    "plan_name": "Pro 5x",
                    "cdk_state": "available"
                  },
                  "trace_id": "9F2A41C07B"
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_key`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_key": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "invalid_key",
                        "message": "密钥无效或已停用",
                        "retryable": false
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "`cdk_used`、`cdk_not_usable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "cdk_used": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "cdk_used",
                        "message": "卡密已兑换或已使用",
                        "retryable": false,
                        "cdk_state": "used",
                        "details": {
                          "order_no": "OD3F9A1C07B2D4E5"
                        }
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "`cdk_invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "cdk_invalid": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "cdk_invalid",
                        "message": "卡密无效，请核对后重试",
                        "retryable": false
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "`busy`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "busy": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "busy",
                        "message": "当前请求较多，请稍后再试",
                        "retryable": true,
                        "retry_after": 30
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "`try_later`、`service_unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/redeem/verify": {
      "post": {
        "tags": [
          "兑换"
        ],
        "operationId": "verifyAccount",
        "summary": "核对账号",
        "description": "核对买家的账号能不能兑换这张卡密。通过（`eligible: true`）就返回 `ticket`（10 分钟内有效、只能用于一次兑换）。账号已有生效中的套餐时 HTTP 仍是 200，但 `eligible: false`、没有 `ticket`。这一步要 10 秒左右，请把超时设到 60 秒以上。不消耗卡密。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              },
              "example": {
                "cdk": "XXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXX",
                "session": "{\"user\":{...},\"accessToken\":\"...\"}"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "核对完成（看 eligible）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "成功",
                  "required": [
                    "ok",
                    "data",
                    "trace_id"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/VerifyData"
                    },
                    "trace_id": {
                      "$ref": "#/components/schemas/TraceID"
                    }
                  }
                },
                "examples": {
                  "可以兑换": {
                    "value": {
                      "ok": true,
                      "data": {
                        "eligible": true,
                        "ticket": "tk_3f9a1c07b2d4e5a6b7c8d9e0f1a2b3c4",
                        "expires_at": "2026-10-05T09:10:00Z",
                        "plan": "pro-5x",
                        "plan_name": "Pro 5x",
                        "account": {
                          "email": "bu***@example.com",
                          "current_plan": "free",
                          "current_plan_name": "Free",
                          "has_active_plan": false
                        }
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  },
                  "账号已有套餐": {
                    "value": {
                      "ok": true,
                      "data": {
                        "eligible": false,
                        "reason": "account_has_plan",
                        "message": "这个账号已有生效中的套餐，不能叠加，请换一个账号。卡密未消耗",
                        "plan": "pro-5x",
                        "plan_name": "Pro 5x",
                        "account": {
                          "email": "bu***@example.com",
                          "current_plan": "plus",
                          "current_plan_name": "Plus",
                          "has_active_plan": true
                        }
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`、`session_format`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "session_format": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "session_format",
                        "message": "Session 格式不对：请打开 chatgpt.com/api/auth/session，把整页内容完整复制过来",
                        "retryable": false,
                        "cdk_state": "available"
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "`cdk_used`、`cdk_not_usable`、`wait_before_retry`、`account_not_eligible`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "cdk_used": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "cdk_used",
                        "message": "卡密已兑换或已使用",
                        "retryable": false,
                        "cdk_state": "used",
                        "details": {
                          "order_no": "OD3F9A1C07B2D4E5"
                        }
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  },
                  "wait_before_retry": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "wait_before_retry",
                        "message": "请过两分钟之后再尝试。卡密未消耗",
                        "retryable": true,
                        "retry_after": 87,
                        "cdk_state": "available"
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "`session_invalid`、`cdk_invalid`、`request_rejected`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "cdk_invalid": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "cdk_invalid",
                        "message": "卡密无效，请核对后重试",
                        "retryable": false
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "`busy`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "busy": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "busy",
                        "message": "当前请求较多，请稍后再试",
                        "retryable": true,
                        "retry_after": 30
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "`try_later`、`service_unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/redeem": {
      "post": {
        "tags": [
          "兑换"
        ],
        "operationId": "redeem",
        "summary": "确认兑换",
        "description": "用核对票据确认兑换，返回订单（开通在后台进行）。从这一步开始卡密才会被占用。\n\n**重试规则**：请求超时、没拿到响应、收到 5xx，或者收到 `busy` / `too_many_inflight` / `service_unavailable` / `try_later`，都用**同一张 ticket、同一个 idempotency_key** 原样再发——会返回同一张订单，不会重复兑换；也可以用 `POST /orders/lookup` 按卡密找回。收到其他错误时这张 ticket 已作废：处理完问题后从核对账号重新来，并换一个新的幂等号。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRequest"
              },
              "example": {
                "ticket": "tk_3f9a1c07b2d4e5a6b7c8d9e0f1a2b3c4",
                "idempotency_key": "order-20261005-000123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已受理（或同一个幂等号重试，返回原来那张单）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "成功",
                  "required": [
                    "ok",
                    "data",
                    "trace_id"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Order"
                    },
                    "trace_id": {
                      "$ref": "#/components/schemas/TraceID"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "data": {
                    "order_no": "OD3F9A1C07B2D4E5",
                    "status": "processing",
                    "cdk_state": "held",
                    "plan": "pro-5x",
                    "plan_name": "Pro 5x",
                    "buyer_email": "bu***@example.com",
                    "message": "开通中，通常 1–3 分钟。请不要重复提交。卡密已锁定。",
                    "created_at": "2026-10-05T09:02:11Z",
                    "updated_at": "2026-10-05T09:02:11Z",
                    "poll_after": 8
                  },
                  "trace_id": "9F2A41C07B"
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "`no_such_ticket`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`ticket_expired`、`ticket_used`、`idempotency_key_reused`、`wait_before_retry`、`account_has_plan`、`cdk_used`、`cdk_not_usable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ticket_expired": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "ticket_expired",
                        "message": "这次核对已过期，请重新核对账号。卡密未消耗",
                        "retryable": false,
                        "cdk_state": "available"
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  },
                  "ticket_used": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "ticket_used",
                        "message": "这次核对已经提交过了",
                        "retryable": false,
                        "details": {
                          "order_no": "OD3F9A1C07B2D4E5"
                        }
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  },
                  "wait_before_retry": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "wait_before_retry",
                        "message": "请过两分钟之后再尝试。卡密未消耗",
                        "retryable": true,
                        "retry_after": 87,
                        "cdk_state": "available"
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  },
                  "cdk_used": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "cdk_used",
                        "message": "卡密已兑换或已使用",
                        "retryable": false,
                        "cdk_state": "used",
                        "details": {
                          "order_no": "OD3F9A1C07B2D4E5"
                        }
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "`session_invalid`、`request_rejected`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_inflight`、`busy`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "busy": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "busy",
                        "message": "当前请求较多，请稍后再试",
                        "retryable": true,
                        "retry_after": 30
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "`try_later`、`service_unavailable`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_no}": {
      "get": {
        "tags": [
          "订单"
        ],
        "operationId": "getOrder",
        "summary": "查订单",
        "description": "查一张订单现在的状态。只能查你这把密钥提交的订单。没出结果时按 `poll_after` 秒再查，请不要比它查得更勤。",
        "parameters": [
          {
            "name": "order_no",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OrderNo"
            },
            "example": "OD3F9A1C07B2D4E5"
          }
        ],
        "responses": {
          "200": {
            "description": "订单现在的样子",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "成功",
                  "required": [
                    "ok",
                    "data",
                    "trace_id"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Order"
                    },
                    "trace_id": {
                      "$ref": "#/components/schemas/TraceID"
                    }
                  }
                },
                "examples": {
                  "开通中": {
                    "value": {
                      "ok": true,
                      "data": {
                        "order_no": "OD3F9A1C07B2D4E5",
                        "status": "processing",
                        "cdk_state": "held",
                        "plan": "pro-5x",
                        "plan_name": "Pro 5x",
                        "buyer_email": "bu***@example.com",
                        "message": "开通中，通常 1–3 分钟。请不要重复提交。卡密已锁定。",
                        "created_at": "2026-10-05T09:02:11Z",
                        "updated_at": "2026-10-05T09:02:11Z",
                        "poll_after": 8
                      },
