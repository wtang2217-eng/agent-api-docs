    "/orders/lookup": {
      "post": {
        "tags": [
          "订单"
        ],
        "operationId": "lookupOrder",
        "summary": "按卡密找回订单",
        "description": "返回你这把密钥对这张卡密提交的最近一张订单（格式同查订单）；没有就是 404 `no_such_order`。订单号弄丢了、页面刷新了、或者提交时没拿到响应的时候用。卡密放在请求体里、不放网址里。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CDKRequest"
              },
              "example": {
                "cdk": "XXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXX"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "找到的订单",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "成功",
                  "required": [
                    "ok",
                    "data",
                    "trace_id"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Order"
                    },
                    "trace_id": {
                      "$ref": "#/components/schemas/TraceID"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "data": {
                    "order_no": "OD3F9A1C07B2D4E5",
                    "status": "processing",
                    "cdk_state": "held",
                    "plan": "pro-5x",
                    "plan_name": "Pro 5x",
                    "buyer_email": "bu***@example.com",
                    "message": "开通中，通常 1–3 分钟。请不要重复提交。卡密已锁定。",
                    "created_at": "2026-10-05T09:02:11Z",
                    "updated_at": "2026-10-05T09:02:11Z",
                    "poll_after": 8
                  },
                  "trace_id": "9F2A41C07B"
                }
              }
            }
          },
          "400": {
            "description": "`bad_request`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_key`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_key": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "invalid_key",
                        "message": "密钥无效或已停用",
                        "retryable": false
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "`no_such_order`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "no_such_order": {
                    "value": {
                      "ok": false,
                      "error": {
                        "code": "no_such_order",
                        "message": "没有找到这张订单",
                        "retryable": false
                      },
                      "trace_id": "9F2A41C07B"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
