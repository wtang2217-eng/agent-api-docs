  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer <密钥>。密钥 cpa_ 开头、共 47 个字符，只放在你的服务器上"
      }
    },
    "schemas": {
      "TraceID": {
        "type": "string",
        "pattern": "^[0-9A-F]{10}$",
        "description": "每个响应都有；联系我们排查问题时请带上它",
        "example": "9F2A41C07B"
      },
      "OrderNo": {
        "type": "string",
        "pattern": "^OD[0-9A-F]{14}$",
        "example": "OD3F9A1C07B2D4E5"
      },
      "Ticket": {
        "type": "string",
        "pattern": "^tk_[0-9a-f]{32}$",
        "description": "核对票据：10 分钟内有效，只能用于一次兑换",
        "example": "tk_3f9a1c07b2d4e5a6b7c8d9e0f1a2b3c4"
      },
      "Time": {
        "type": "string",
        "format": "date-time",
        "description": "RFC 3339 的 UTC 时间",
        "example": "2026-10-05T09:00:00Z"
      },
      "MaskedEmail": {
        "type": "string",
        "description": "打码后的账号邮箱",
        "example": "bu***@example.com"
      },
      "CDKState": {
        "type": "string",
        "enum": [
          "available",
          "held",
          "used"
        ],
        "description": "卡密现在的状态：available 还没消耗（可以重新核对、重新提交）/ held 已锁定（正在处理或等人工核对，不能重复提交）/ used 已使用"
      },
      "Plan": {
        "type": "string",
        "enum": [
          "go",
          "plus",
          "pro-5x",
          "pro-20x",
          "pro-max",
          "other"
        ],
        "description": "套餐代号；以后新增的套餐会先用 other"
      },
      "PlanName": {
        "type": "string",
        "enum": [
          "Go",
          "Plus",
          "Pro 5x",
          "Pro 20x",
          "Pro Max",
          "ChatGPT 套餐"
        ]
      },
      "CurrentPlan": {
        "type": "string",
        "enum": [
          "free",
          "go",
          "plus",
          "pro-5x",
          "pro-20x",
          "pro-max",
          "other"
        ]
      },
      "CurrentPlanName": {
        "type": "string",
        "enum": [
          "Free",
          "Go",
          "Plus",
          "Pro 5x",
          "Pro 20x",
          "Pro Max",
          "ChatGPT 套餐"
        ]
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "processing",
          "succeeded",
          "failed",
          "under_review"
        ],
        "description": "processing 开通中 / succeeded 已开通（终态）/ failed 失败（终态）/ under_review 需要人工核对（之后会变成 succeeded 或 failed）"
      },
      "FailureCode": {
        "type": "string",
        "enum": [
          "session_invalid",
          "account_has_plan",
          "account_restricted",
          "payment_blocked",
          "payment_failed",
          "try_later",
          "cancelled",
          "not_accepted",
          "recharge_failed"
        ]
      },
      "FailureAction": {
        "type": "string",
        "enum": [
          "retry_later",
          "change_account",
          "recopy_session"
        ],
        "description": "建议界面怎么引导买家：过两分钟再试 / 换一个账号 / 重新复制 Session"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_key",
          "ip_not_allowed",
          "service_disabled",
          "rate_limited",
          "too_many_failures",
          "busy",
          "too_many_inflight",
          "bad_request",
          "not_found",
          "cdk_invalid",
          "cdk_used",
          "cdk_not_usable",
          "session_format",
          "session_invalid",
          "account_not_eligible",
          "account_has_plan",
          "wait_before_retry",
          "no_such_ticket",
          "ticket_expired",
          "ticket_used",
          "idempotency_key_reused",
          "no_such_order",
          "request_rejected",
          "try_later",
          "service_unavailable",
          "internal_error"
        ],
        "description": "- `invalid_key`（HTTP 401）：密钥无效或已停用\n- `ip_not_allowed`（HTTP 403）：来源 IP 不在这把密钥登记的名单里（error.details.ip 是我们看到的你的来源 IP）\n- `service_disabled`（HTTP 503）：接口暂时关闭\n- `rate_limited`（HTTP 429）：请求过于频繁\n- `too_many_failures`（HTTP 429）：来自这个 IP 的错误请求过多，被临时封锁\n- `busy`（HTTP 429）：系统繁忙，按 Retry-After 稍后重试\n- `too_many_inflight`（HTTP 429）：同时处理的订单已达上限\n- `bad_request`（HTTP 400）：请求格式不对\n- `not_found`（HTTP 404）：接口不存在\n- `cdk_invalid`（HTTP 422）：卡密无效\n- `cdk_used`（HTTP 409）：卡密已兑换或已使用\n- `cdk_not_usable`（HTTP 409）：卡密暂时不能用（停用、冻结或正在处理）\n- `session_format`（HTTP 400）：Session 不是整页内容\n- `session_invalid`（HTTP 422）：账号登录已失效\n- `account_not_eligible`（HTTP 409）：账号现在不能充值这个套餐\n- `account_has_plan`（HTTP 409）：账号已有生效中的套餐\n- `wait_before_retry`（HTTP 409）：这个账号要等一会儿再试（带 retry_after）\n- `no_such_ticket`（HTTP 404）：没有这张核对票据\n- `ticket_expired`（HTTP 409）：核对已过期或已作废，重新核对账号\n- `ticket_used`（HTTP 409）：这张票据已经提交过（error.details.order_no 是对应订单）\n- `idempotency_key_reused`（HTTP 409）：幂等号已用于另一张票据\n- `no_such_order`（HTTP 404）：没有这张订单\n- `request_rejected`（HTTP 422）：请求没有通过\n- `try_later`（HTTP 503）：请过两分钟之后再尝试\n- `service_unavailable`（HTTP 503）：服务暂时不可用\n- `internal_error`（HTTP 500）：服务内部错误"
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "给终端买家看的中文句子，可以直接显示"
          },
          "retryable": {
            "type": "boolean",
            "description": "同样的操作稍后能不能再做一次（怎么重来以各接口的说明为准）"
          },
          "retry_after": {
            "type": "integer",
            "minimum": 1,
            "maximum": 900,
            "description": "建议等多少秒；同时放在 Retry-After 响应头里"
          },
          "cdk_state": {
            "$ref": "#/components/schemas/CDKState"
          },
          "details": {
            "type": "object",
            "properties": {
              "order_no": {
                "$ref": "#/components/schemas/OrderNo"
              },
              "ip": {
                "type": "string",
                "description": "来源 IP 被拒绝时，我们看到的你的来源 IP"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "ok",
          "error",
          "trace_id"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "trace_id": {
            "$ref": "#/components/schemas/TraceID"
          }
        }
      },
      "PingData": {
        "type": "object",
        "required": [
          "name",
          "ip",
          "server_time",
          "limits"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "这把密钥的名字"
          },
          "ip": {
            "type": "string",
            "description": "我们看到的你的来源 IP"
          },
          "server_time": {
            "$ref": "#/components/schemas/Time"
          },
          "limits": {
            "type": "object",
            "properties": {
              "rate_per_min": {
                "type": "integer",
                "description": "每分钟请求上限"
              },
              "max_inflight": {
                "type": "integer",
                "description": "同时处理的订单上限"
              }
            }
          }
        }
      },
      "CDKRequest": {
        "type": "object",
        "required": [
          "cdk"
        ],
        "properties": {
          "cdk": {
            "type": "string",
            "description": "卡密；大小写、首尾空格不敏感"
          }
        }
      },
      "QueryData": {
        "type": "object",
        "required": [
          "plan",
          "plan_name",
          "cdk_state"
        ],
        "properties": {
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "plan_name": {
            "$ref": "#/components/schemas/PlanName"
          },
          "cdk_state": {
            "$ref": "#/components/schemas/CDKState"
          }
        }
      },
      "VerifyRequest": {
        "type": "object",
        "required": [
          "cdk",
          "session"
        ],
        "properties": {
          "cdk": {
            "type": "string"
          },
          "session": {
            "description": "买家的整页 Session：在已登录 ChatGPT 的浏览器里打开 https://chatgpt.com/api/auth/session，把页面上的整段内容（以 { 开头，里面有 accessToken）原样传过来。可以是字符串，也可以直接是 JSON 对象。只在这一次请求里用，不要保存、不要写日志。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "email",
          "current_plan",
          "current_plan_name",
          "has_active_plan"
        ],
        "properties": {
          "email": {
            "$ref": "#/components/schemas/MaskedEmail"
          },
          "current_plan": {
            "$ref": "#/components/schemas/CurrentPlan"
          },
          "current_plan_name": {
            "$ref": "#/components/schemas/CurrentPlanName"
          },
          "has_active_plan": {
            "type": "boolean",
            "description": "true 时 eligible 一定是 false"
          }
        }
      },
      "VerifyData": {
        "type": "object",
        "required": [
          "eligible",
          "plan",
          "plan_name",
          "account"
        ],
        "description": "eligible=true 时有 ticket、expires_at；eligible=false 时有 reason、message，没有 ticket",
        "properties": {
          "eligible": {
            "type": "boolean"
          },
          "ticket": {
            "$ref": "#/components/schemas/Ticket"
          },
          "expires_at": {
            "$ref": "#/components/schemas/Time"
          },
          "reason": {
            "type": "string",
            "enum": [
              "account_has_plan"
            ]
          },
          "message": {
            "type": "string",
            "description": "给买家看的中文句子"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "plan_name": {
            "$ref": "#/components/schemas/PlanName"
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          }
        }
      },
      "RedeemRequest": {
        "type": "object",
        "required": [
          "ticket",
          "idempotency_key"
        ],
        "properties": {
          "ticket": {
            "$ref": "#/components/schemas/Ticket"
          },
          "idempotency_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{8,64}$",
            "description": "幂等号：每一次新的兑换尝试用一个新值（推荐用你系统里的订单号或 UUID），同一次尝试的所有重试用同一个值"
          }
        }
      },
      "Failure": {
        "type": "object",
        "required": [
          "code",
          "action"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/FailureCode"
          },
          "action": {
            "$ref": "#/components/schemas/FailureAction"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "order_no",
          "status",
          "cdk_state",
          "plan",
          "plan_name",
          "buyer_email",
          "message",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "order_no": {
            "$ref": "#/components/schemas/OrderNo"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "cdk_state": {
            "$ref": "#/components/schemas/CDKState"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "plan_name": {
            "$ref": "#/components/schemas/PlanName"
          },
          "buyer_email": {
            "$ref": "#/components/schemas/MaskedEmail"
          },
          "message": {
            "type": "string",
            "description": "这一单现在的情况，给买家看的中文句子（末尾说明卡密有没有消耗）"
          },
          "created_at": {
            "$ref": "#/components/schemas/Time"
          },
          "updated_at": {
            "$ref": "#/components/schemas/Time"
          },
          "finished_at": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Time"
              }
            ],
            "description": "只有 succeeded、failed 才有"
          },
          "poll_after": {
            "type": "integer",
            "description": "只在没出结果时出现：建议多少秒后再来查（开通中 8 秒，人工核对 60 秒）"
          },
          "failure": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Failure"
              }
            ],
            "description": "只在 failed 时出现"
          }
        }
      }
    }
  }
}
